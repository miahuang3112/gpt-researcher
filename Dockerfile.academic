FROM python:3.15-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install Python dependencies first so Docker can cache this layer.
COPY requirements-academic.txt /app/requirements-academic.txt

RUN python -m pip install --upgrade pip \
    && python -m pip install \
        --prefer-binary \
        -r /app/requirements-academic.txt

# Copy the project only after dependencies are installed.
COPY . /app

# Run as a non-root user.
RUN useradd --create-home --uid 10001 academic \
    && mkdir -p /data/academic \
    && chown -R academic:academic /app /data/academic

USER academic

EXPOSE 8001

CMD ["python", "-m", "uvicorn", "backend.academic_api.main:app", "--host", "0.0.0.0", "--port", "8001"]
